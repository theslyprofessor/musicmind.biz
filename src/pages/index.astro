---
import PageLayout from "@/layouts/PageLayout.astro";
import { Badge } from "@/components/ui/badge";
import { ContactForm } from "@/components/react/ContactForm";
import { SITE_CONFIG, PRODUCTS, SERVICES, WHY_MUSICMIND } from "@/lib/constants";
import { CheckCircle, ArrowRight, Lightbulb, FileText, Scale, Award, DollarSign, Mic } from "lucide-react";

const iconMap: Record<string, any> = { Lightbulb, FileText, Scale, Award, DollarSign, Mic };
---

<PageLayout>
  <!-- Hero Section -->
  <section class="gradient-hero min-h-screen flex items-center pt-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
      <div class="max-w-4xl">
        <Badge variant="outline" className="mb-6">
          Music Technology, Studio Software &amp; Business Strategy · Affiliated with Build Forward Tech
        </Badge>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight mb-6">
          <span class="gradient-text">Your Music.</span>
          <br />
          <span class="text-foreground">Your Studio &amp; Business. Powered.</span>
        </h1>
        <p class="text-xl text-muted-foreground mb-8 max-w-2xl">
          Commercial studio software (<a href="https://buildforwardtech.com/screenstage" class="text-primary underline">ScreenStage</a>, <a href="https://buildforwardtech.com/quietplease" class="text-primary underline">QuietPlease</a>, <a href="https://buildforwardtech.com/trackcascade" class="text-primary underline">TrackCascade</a>, Midimaze), catalog administration, licensing workflows, and strategic business consulting built in affiliation with <a href="https://buildforwardtech.com/#labs" class="text-primary underline">Build Forward Tech</a>.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="#products"
            class="inline-flex items-center justify-center gap-2 bg-primary text-primary-foreground px-8 py-4 rounded-md font-semibold hover:bg-primary/90 transition-colors"
          >
            Explore Studio Software
            <ArrowRight className="h-5 w-5" />
          </a>
          <a
            href="#services"
            class="inline-flex items-center justify-center gap-2 border border-input bg-background px-8 py-4 rounded-md font-semibold hover:bg-accent hover:text-accent-foreground transition-colors"
          >
            Business &amp; Studio Services
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Software & Tools Section (Affiliated with Build Forward Tech) -->
  <section id="products" class="py-24 bg-card border-y border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <Badge variant="accent" className="mb-4">MusicMind × Build Forward Tech Labs</Badge>
        <h2 class="text-3xl sm:text-4xl font-bold mb-4">Studio Software &amp; Creator Tools</h2>
        <p class="text-muted-foreground text-lg max-w-3xl mx-auto">
          We build and ship native macOS, Windows, and web tools for recording studios, educators, and multi-monitor workstations in partnership with <a href="https://buildforwardtech.com/#labs" class="text-primary underline">Build Forward Tech Labs</a>.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {PRODUCTS.map((product) => (
          <div class="p-6 rounded-xl bg-background border border-border hover:border-primary/60 transition-all flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="text-xs font-mono uppercase tracking-wider text-primary font-semibold">{product.tag}</span>
                <span class="text-xs px-2.5 py-0.5 rounded-full bg-primary/15 text-primary font-medium">{product.status}</span>
              </div>
              <h3 class="text-xl font-bold mb-2">{product.name}</h3>
              <p class="text-muted-foreground text-sm leading-relaxed mb-4">{product.description}</p>
            </div>
            <div>
              <div class="text-xs text-muted-foreground font-mono mb-3">{product.price}</div>
              <a
                href={product.href}
                target="_blank"
                rel="noopener noreferrer"
                class="block w-full py-2.5 px-4 rounded-lg bg-primary text-primary-foreground text-center text-sm font-semibold hover:bg-primary/90 transition"
              >
                {product.cta}
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section id="services" class="py-24 bg-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold mb-4">What We Do</h2>
        <p class="text-muted-foreground text-lg max-w-2xl mx-auto">
          Full-service music business and studio operations support from your first release to institutional studio deployments.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {SERVICES.map((service) => {
          const Icon = iconMap[service.icon];
          return (
            <div class="group p-6 rounded-xl bg-card border border-border hover:border-primary/50 transition-all card-hover">
              <div class="inline-flex p-3 rounded-lg bg-primary/10 text-primary mb-4">
                {Icon && <Icon className="h-6 w-6" />}
              </div>
              <h3 class="text-lg font-semibold mb-2">{service.title}</h3>
              <p class="text-muted-foreground text-sm leading-relaxed">{service.description}</p>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Why MusicMind -->
  <section id="about" class="py-24 bg-card">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <Badge variant="accent" className="mb-4">
            Why MusicMind
          </Badge>
          <h2 class="text-3xl sm:text-4xl font-bold mb-6">
            Built by People Who Build the Tools
          </h2>
          <p class="text-muted-foreground text-lg mb-8">
            We are musicians, studio engineers, educators, and software architects. In affiliation with <a href="https://buildforwardtech.com" class="text-primary underline">Build Forward Tech</a>, we ship commercial studio software alongside hands-on music business and catalog consulting.
          </p>
          <ul class="space-y-4">
            {WHY_MUSICMIND.map((item) => (
              <li class="flex items-start gap-3">
                <CheckCircle className="h-5 w-5 text-primary shrink-0 mt-0.5" />
                <span class="text-muted-foreground">{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="relative">
          <div class="aspect-square rounded-2xl bg-gradient-to-br from-primary/20 to-accent/20 flex items-center justify-center">
            <div class="text-center">
              <div class="w-32 h-32 rounded-full bg-card border-4 border-primary/30 mx-auto mb-4 flex items-center justify-center">
                <span class="text-5xl">🎵</span>
              </div>
              <p class="text-lg font-semibold gradient-text">Your music and studio deserve</p>
              <p class="text-lg font-semibold gradient-text">real software and business systems.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="py-24 bg-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div>
          <Badge variant="outline" className="mb-4">
            Get Started
          </Badge>
          <h2 class="text-3xl sm:text-4xl font-bold mb-6">
            Let's Talk About Your Studio or Music Business
          </h2>
          <p class="text-muted-foreground text-lg mb-8">
            Whether you need multi-seat studio licenses for ScreenStage, custom Ableton/Pro Tools workflow engineering, or catalog and publishing administration, reach out below.
          </p>

          <div class="space-y-4 mb-8">
            <div class="flex items-center gap-3">
              <div class="p-2 rounded-lg bg-primary/10 text-primary">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <a href={`mailto:${SITE_CONFIG.email}`} class="text-foreground hover:text-primary transition-colors">
                {SITE_CONFIG.email}
              </a>
            </div>
            <div class="flex items-center gap-3">
              <div class="p-2 rounded-lg bg-primary/10 text-primary">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <a href={`tel:${SITE_CONFIG.phone.replace(/[^0-9+]/g, '')}`} class="text-foreground hover:text-primary transition-colors">
                {SITE_CONFIG.phone}
              </a>
            </div>
          </div>

          <div class="p-6 rounded-xl bg-card border border-border">
            <h3 class="font-semibold mb-2">Free 30-Minute Consultation</h3>
            <p class="text-sm text-muted-foreground">
              Tell us what you are building and we will map out your next steps across studio technology and music business operations.
            </p>
          </div>
        </div>

        <div class="bg-card rounded-xl p-8 border border-border">
          <h3 class="text-xl font-semibold mb-6">Send Us a Message</h3>
          <ContactForm client:visible />
        </div>
      </div>
    </div>
  </section>
</PageLayout>
